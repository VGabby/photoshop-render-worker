{
  "id": "com.local.photoshop-render-worker",
  "name": "Photoshop Render Worker",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.0.0"
    }
  ],
  "manifestVersion": 4,
  "entrypoints": [
    {
      "type": "panel",
      "id": "renderWorkerPanel",
      "label": {
        "default": "Render Worker"
      },
      "minimumSize": {
        "width": 260,
        "height": 360
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 520
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 560
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["*"]
    },
    "localFileSystem": "fullAccess"
  }
}
